{
  "name": "@deepseek-harness/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend API for the DeepSeek Harness WebGUI.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deepseek-harness/agent-sdk": "workspace:*",
    "@deepseek-harness/database": "workspace:*",
    "@deepseek-harness/git": "workspace:*",
    "@deepseek-harness/harness": "workspace:*",
    "@deepseek-harness/mcp": "workspace:*",
    "@deepseek-harness/shared": "workspace:*",
    "@deepseek-harness/terminal": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.4",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@deepseek-harness/config-eslint": "workspace:*",
    "@deepseek-harness/config-typescript": "workspace:*",
    "@nestjs/cli": "^10.4.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
