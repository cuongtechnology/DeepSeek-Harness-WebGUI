{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "API_PORT",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "WEB_ORIGIN",
    "RATE_LIMIT_PER_MINUTE",
    "AUTH_ALLOW_REGISTRATION",
    "WORKSPACES_ROOT",
    "SANDBOX_IMAGE",
    "DEEPSEEK_HARNESS_COMMAND",
    "DEEPSEEK_HARNESS_ARGS",
    "DEEPSEEK_HARNESS_PROVIDER",
    "DEEPSEEK_HARNESS_MODEL",
    "DEEPSEEK_HARNESS_MAX_TOKENS",
    "DEEPSEEK_HARNESS_TIMEOUT_MS",
    "DEEPSEEK_HARNESS_KILL_MS",
    "DEEPSEEK_HARNESS_INSTALL_METHOD",
    "DEEPSEEK_HARNESS_INSTALL_COMMAND",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "DSH_CWD",
    "DSH_MODEL",
    "DSH_SESSION_ROOT",
    "DSH_SYSTEM_PROMPT",
    "DSH_CORDIS_CONFIG"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
