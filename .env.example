# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://webgui:webgui@postgres:5432/webgui?schema=public
REDIS_URL=redis://redis:6379

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API (for CORS). Empty = allow all.
WEB_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
# Set to "false" to disable public registration after the first admin exists.
AUTH_ALLOW_REGISTRATION=true

# ── Workspaces & sandbox ────────────────────────────────────────────────────
# Root directory under which project workspaces are created.
WORKSPACES_ROOT=/data/workspaces
# Docker image used by the sandbox worker.
SANDBOX_IMAGE=node:22-slim

# ── DeepSeek Harness runtime ────────────────────────────────────────────────
# The SDK runtime executable the adapter spawns over stdio JSON-RPC.
# It must be the official `dsh-jsonrpc-agent` binary (built from the upstream
# repo or installed via the DeepSeek Harness Python SDK runtime wheel).
DEEPSEEK_HARNESS_COMMAND=dsh-jsonrpc-agent
# Extra arguments passed to the runtime (split on whitespace).
DEEPSEEK_HARNESS_ARGS=
DEEPSEEK_HARNESS_PROVIDER=deepseek-official
DEEPSEEK_HARNESS_MODEL=deepseek-v4-flash
DEEPSEEK_HARNESS_MAX_TOKENS=
DEEPSEEK_HARNESS_TIMEOUT_MS=300000
DEEPSEEK_HARNESS_KILL_MS=3000

# ── DeepSeek Harness runtime environment (inherited by the subprocess) ──────
# Credential read by the harness's LLM adapter. Never commit this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DSH_CWD=
DSH_MODEL=
DSH_SESSION_ROOT=
DSH_SYSTEM_PROMPT=
DSH_CORDIS_CONFIG=

# ── Web ─────────────────────────────────────────────────────────────────────
# Backend URL the Next.js server proxies /api/* to (server-side).
API_URL=http://api:3001
# Backend URL the browser uses for WebSocket connections (client-side).
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Redis (for BullMQ workers) ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
